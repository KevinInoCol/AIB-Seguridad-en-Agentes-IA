# Copia este archivo a .env y completa los valores.

# Proveedor del LLM: openai | ollama
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
# Opcional: sobrescribe el modelo de model_config/model.yaml
# OPENAI_MODEL=gpt-5.1

# --- Ollama (local) ---
# Opcionales: sobrescriben model_config/model.yaml
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_BASE_URL=http://localhost:11434

BOT_NAME=Valeria
EMPRESA=Inmobiliaria Andina

# --- Guardrails: Model Armor (GCP) ---
# Autenticación por ADC: gcloud auth application-default login (sin claves aquí).
MODEL_ARMOR_ENABLED=true
GCP_PROJECT_ID=datapath-kevin-inofuente
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=ai-builders-seguridad-en-ia
# Si Model Armor no responde: closed = bloquear (recomendado) | open = dejar pasar
MODEL_ARMOR_FAIL_MODE=closed
